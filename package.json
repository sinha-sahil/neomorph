{
  "name": "neomorph",
  "private": true,
  "version": "0.0.1",
  "description": "Advanced theme transformation toolkit for web applications",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build:all": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "check": "turbo check",
    "clean": "turbo clean",
    "build:loomer": "turbo build --filter=@neomorph/loomer",
    "build:weaver": "turbo build --filter=@neomorph/weaver",
    "build:sdk": "turbo build --filter=@neomorph/sdk",
    "build:cdn": "turbo build:cdn --filter=@neomorph/sdk",
    "dev:loomer": "turbo dev --filter=@neomorph/loomer",
    "dev:weaver": "turbo dev --filter=@neomorph/weaver",
    "dev:sdk": "turbo dev --filter=@neomorph/sdk",
    "dev:cdn": "turbo dev:cdn --filter=@neomorph/sdk",
    "preview:loomer": "turbo preview --filter=@neomorph/loomer",
    "check:watch": "turbo check:watch --filter=@neomorph/loomer"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
